# Default deny: only the application source and explicitly reviewed files enter Git.
*
!.gitignore
!README.md
!package.json
!package-lock.json
!requirements.txt
!font-characters.txt
!build.mjs
!check.mjs
!test_chat_storage.mjs
!test_cloud_reference.mjs
!test_cloud_session.mjs
!test_live_ui.mjs
!test_session_isolation.mjs
!test_voice_ui.mjs
!test_pixel_wave.mjs
!test_worker.mjs
!test_yero_relay.py
!test_yero_runner.py
!test_yero_voice.py
!yero_relay.py
!yero_runner.py
!yero_voice.py
!src/
!src/**
!assets/
!assets/OFL.txt
!assets/template-atlas.png
!assets/yero-logo.png
!assets/yero-logo-original.png
!cloud/
!cloud/worker.mjs
!cloud/wrangler.example.toml

# Credentials and private local state must never be staged, even under allowed directories.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*secret*
**/*token*
**/*credential*
**/settings.json
